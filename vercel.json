{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -- --base=/",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/work/paylux",
      "destination": "/Paylux.html",
      "permanent": false
    },
    {
      "source": "/work/sja",
      "destination": "/SJA.html",
      "permanent": false
    },
    {
      "source": "/work/religio",
      "destination": "/Religio.html",
      "permanent": false
    },
    {
      "source": "/work/vvl",
      "destination": "/VVL.html",
      "permanent": false
    },
    {
      "source": "/work/onestone",
      "destination": "/OneStone.html",
      "permanent": false
    },
    {
      "source": "/work/line-gift",
      "destination": "/Line%20Gift.html",
      "permanent": false
    }
  ]
}
